# Déclenche segho-releve-hprim.service toutes les 10 minutes.
# Un passage encore en cours n'est jamais doublé ; un passage manqué
# (serveur éteint) est rattrapé au redémarrage.

[Unit]
Description=SEGHO-WALE — relève des résultats de laboratoire toutes les 10 minutes

[Timer]
OnCalendar=*:0/10
Persistent=true
AccuracySec=30s

[Install]
WantedBy=timers.target
